{
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --all)",
      "Bash(git branch -r)",
      "Bash(git branch --remotes)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch -l)",
      "Bash(git branch --list)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --contains *)",
      "Bash(git blame)",
      "Bash(git blame *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git remote)",
      "Bash(git remote *)",
      "Bash(git config --get *)",
      "Bash(git config --list)",
      "Bash(git rev-parse *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr status)",
      "Bash(gh pr status *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(del)",
      "Bash(del *)",
      "Bash(rmdir)",
      "Bash(rmdir *)",
      "Bash(git add)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git branch *)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(Remove-Item)",
      "Bash(Remove-Item *)",
      "Bash(git reset)",
      "Bash(git reset *)"
    ]
  },
  "env": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\restrict-paths.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\remind-claude-md.ps1\""
          }
        ]
      }
    ]
  }
}